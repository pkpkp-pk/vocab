# Local browser configuration; only the URL and publishable key are public.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Local Vercel Function configuration (`vercel dev`); use the same values.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only secret for `vercel dev` and deployed Vercel Functions.
GEMINI_API_KEY=your-gemini-api-key

# Optional comma-separated Gemini scoring model IDs; each scoring request rotates to the next.
# GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.7-flash
# Live speech-to-text uses gemini-3.5-transcribe-live separately.
